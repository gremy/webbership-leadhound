# Copy to .env and fill in. Placeholders only; real values never enter the repository.

# Database (app role: SELECT, INSERT, UPDATE only)
LEADHOUND_DATABASE_URL=postgres://leadhound_app@db.example:5432/leadhound?sslmode=require
# Database (owner role: migrations only)
LEADHOUND_MIGRATE_DATABASE_URL=postgres://leadhound_owner@db.example:5432/leadhound?sslmode=require

# Private data directory, outside the repository
LEADHOUND_DATA_DIR=/path/outside/the/repo/leadhound

# Scoring model
TYPESAFE_API_KEY=replace-me
LEADHOUND_JEV_MODEL=jev-1.13.0
LEADHOUND_JEV_DAILY_CALL_CAP=300
# Runaway guard for lead relevance rating, separate from the jobs cap above (default 10000).
LEADHOUND_JEV_LEADS_DAILY_CALL_CAP=10000

# Daily brief mail
RESEND_API_KEY=replace-me
LEADHOUND_MAIL_FROM=leadhound@mail.example
LEADHOUND_MAIL_TO=you@mail.example

# Day boundaries and rate limits
LEADHOUND_TZ=Europe/Bucharest
LEADHOUND_LINKEDIN_INTERVAL=4s
LEADHOUND_LINKEDIN_SEARCH_BUDGET=60
LEADHOUND_LINKEDIN_DETAIL_BUDGET=40
# Pause between two requests to one ATS's API (the ATSs run side by side,
# each at this pace). At least 200ms; a lower value is refused.
LEADHOUND_ATS_INTERVAL=1s
# Posting-detail requests per ATS run, for an ATS whose list has no description
# (SmartRecruiters): new postings first. A posting over the budget is stored
# without its description and gets it on a later run.
LEADHOUND_ATS_DETAIL_BUDGET=500

# Storage fences: collectors stop storing when the database passes this size in
# bytes (default 8589934592, 8 GiB) or free disk drops under this percent (1 to
# 99, default 15). Empty keeps the default.
LEADHOUND_DB_MAX_BYTES=
LEADHOUND_DISK_MIN_FREE_PCT=

# Live fetching. Leave unset in development: without it no command makes a
# network request to a job source. Values: 1 (everything, server only) or
# ats (public ATS board APIs only).
# LEADHOUND_LIVE=

# Console (leadhound serve). Unset in development unless you run it. The
# address must be loopback (default 127.0.0.1:8090); serve refuses to start
# without the email and the hash (make console-password writes the hash).
# LEADHOUND_CONSOLE_ADDR=127.0.0.1:8090
# LEADHOUND_CONSOLE_EMAIL=you@mail.example
# LEADHOUND_CONSOLE_PASSWORD_HASH=replace-me
# LEADHOUND_CONSOLE_URL=https://console.example

# Leads outreach mailbox. Unset LEADHOUND_OUTREACH is shadow: leads send writes
# messages to <data dir>/outreach-outbox/ and sends nothing; live sends over SMTP.
LEADHOUND_SMTP_ADDR=mail.example:465
LEADHOUND_IMAP_ADDR=mail.example:993
LEADHOUND_OUTREACH_USER=outreach@mail.example
LEADHOUND_OUTREACH_PASSWORD=
LEADHOUND_OUTREACH=
# Leads site probe: sites probed at once (1 to 64) and requests per second
# across a run (1 to 50).
LEADHOUND_PROBE_CONCURRENCY=16
LEADHOUND_PROBE_RATE=12

# Optional: path to the private denylist used by cmd/privacycheck
# (outside contributors set it to none).
# LEADHOUND_DENYLIST=none
