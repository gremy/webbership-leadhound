# LinkedIn collect, then a score of what it stored. Started by leadhound-collect.timer's
# 15-minute ticks, through the due-check below, and by leadhound-fetch.service, which pulls it
# in (Wants=) when the console's Fetch new jobs asks.
#
# Every subcommand exits 0 once it has recorded its outcome, a stop (throttled, budget,
# parser_broke, spend_cap ...) included, and non-zero only for a crash or bad config.
# Every step but the last is written ExecStart=-..., so even a crash never stops a later one.
[Unit]
Description=leadhound LinkedIn collect and score
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=leadhound
Group=leadhound
# root:root 0600; systemd reads it before dropping to leadhound (deploy/env.example).
EnvironmentFile=/etc/leadhound/env
# The due-check, before any step: it starts the job for a Run now press at once, or when it is
# due (one interval after its last start, by hand or timed), and opens the run's row, the
# anchor of the next plan. Any doubt (not due, the job sharing its lock running, the database
# unreadable, a crash, the 1-minute timeout) exits 1-254, so systemd passes over this tick
# without a failure and the next tick tries again. --record is what lets it write, so a check
# run by hand never moves the plan. No - prefix: it would turn every "not now" into a start. A
# Fetch press reaches this unit only through leadhound-fetch.service's Wants=, never through a
# watcher of its own: the console writes run/fetch before leadhound-fetch.path starts the
# fetch, so when the fetch pulls this unit in, the check sees that fresh request and lets the
# collect through as the press's run. A collect already running is joined, and the check counts
# it as the press's.
ExecCondition=/usr/bin/timeout 1m /opt/leadhound/bin/leadhound timer-guard --record collect
# Every LinkedIn step on this server (this collect, the canary, the brief's recheck) holds
# /opt/leadhound/data/.linkedin.lock, so two never run at once. A collect that cannot get it within 30 minutes
# exits 75 and is skipped (the - prefix); timeout ends one that hangs. Either way the score
# below still runs.
ExecStart=-/usr/bin/flock --wait 1800 --conflict-exit-code 75 /opt/leadhound/data/.linkedin.lock /usr/bin/timeout --kill-after=5m 2h /opt/leadhound/bin/leadhound collect linkedin
# Two units may score at once (a long night collect running into the morning one), so
# score waits for the other on a lock in the data directory instead of running beside it.
# The score stops itself cleanly at its 45-minute budget; timeout ends one that hangs. The
# timeout leaves 15 minutes over the budget because a stopped score still finishes its
# in-flight job, records the run and makes its summary pass over every stored job.
ExecStart=/usr/bin/flock --wait 5400 /opt/leadhound/data/.score.lock /usr/bin/timeout --kill-after=2m 1h /opt/leadhound/bin/leadhound score --max-duration 45m
# After the last step, whatever happened: closes the run's row with systemd's own result
# ($SERVICE_RESULT, $EXIT_STATUS), also after a failure, a timeout or a kill. It does nothing
# after a tick the due-check passed over. The - keeps a failed close from marking the run
# failed; the next check closes a row left open.
ExecStopPost=-/usr/bin/timeout 1m /opt/leadhound/bin/leadhound timer-guard --record --ended collect
# Longer than the due-check's minute, the LinkedIn lock wait, the collect's timeout, the
# score's lock wait and the score's timeout together (5h08), so systemd never cuts the score
# short.
TimeoutStartSec=5h31min
Nice=5
# The server is shared: a ceiling on memory, so the kernel stops leadhound and never a
# neighbour. Past MemoryMax the unit is killed; there is no MemoryHigh, because a unit
# throttled there hangs instead of failing. GOMEMLIMIT makes Go collect garbage harder
# well before the ceiling.
# A LinkedIn collect has peaked near 530 MB and is not streamed.
MemoryMax=1G
Environment=GOMEMLIMIT=850MiB
# Half the default CPU share, so a long collect yields to the server's other services.
CPUWeight=50
# Hardening. The whole file system is read-only to leadhound except the data directory
# (LEADHOUND_DATA_DIR), where a brief that is not sent goes to its outbox and the score lock
# lives. It needs the network (job sources, the scoring API, mail, Postgres) and nothing else.
WorkingDirectory=/opt/leadhound
ReadWritePaths=/opt/leadhound/data
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Only the jobs that send, sync and check a mailbox get its private key, as a systemd
# credential; this unit sees none, so it can never read a mailbox password back.
InaccessiblePaths=-/run/credentials
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
