# Check email now, for a manual Send now: leads verify --from-request reads the batch the
# console's request file names and checks that batch's first-email addresses that have no
# answer yet (at most 25), inside the Email check switch, the day's cap and the credits left,
# storing each answer; the confirm page then shows each lead as ready or left out. Nothing is
# drafted or sent. The request file is untrusted: it names a batch, and the addresses come
# from the database. Started by leadhound-leads-verify-now.path when the console asks; it has
# no timer. Without LEADHOUND_LIVE or without the key it calls nobody and says so.
[Unit]
Description=leadhound Check email now
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=leadhound
Group=leadhound
# root:root 0600; systemd reads it before dropping to leadhound (deploy/env.example).
EnvironmentFile=/etc/leadhound/env
# The Reoon key (root:root 0600, placed by the operator by hand), handed to this job as a
# systemd credential: it reads $CREDENTIALS_DIRECTORY/reoon.key (deploy/README.md, The Reoon
# key). It gets no other key. SetCredential= with the same name is systemd's default for when
# the file cannot be read, so a server without the key still starts the unit, which says
# there is no key and records nothing.
LoadCredential=reoon.key:/etc/leadhound/reoon.key
SetCredential=reoon.key:
# timeout ends a run that hangs: each check has its own shorter limit, so 10 minutes covers 25.
ExecStart=/usr/bin/timeout --kill-after=1m 10m /opt/leadhound/bin/leadhound leads verify --from-request --max 25
# Longer than the step's timeout and its kill grace together.
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
# The server is shared: a ceiling on memory, so the kernel stops leadhound and never a
# neighbour. Past MemoryMax the unit is killed; there is no MemoryHigh, because a unit
# throttled there hangs instead of failing. GOMEMLIMIT makes Go collect garbage harder
# well before the ceiling.
MemoryMax=600M
Environment=GOMEMLIMIT=450MiB
# Half the default CPU share, so a run yields to the server's other services.
CPUWeight=50
# Hardening. The whole file system is read-only to leadhound except the data directory
# (LEADHOUND_DATA_DIR). It needs the network (the Reoon API, Postgres) and nothing else.
WorkingDirectory=/opt/leadhound
ReadWritePaths=/opt/leadhound/data
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No InaccessiblePaths=-/run/credentials here: it would hide the unit's own Reoon key.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
