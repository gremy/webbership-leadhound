# The daily contact search: up to 300 organisations searched for a published way to reach
# them, each page with its robots file, then up to 300 organisations enriched with the
# phones, description and social links on their own pages, then every open lead whose facts
# changed rated for relevance by Jev, first the drupal-eol campaign's and then the
# cafes-loyalty campaign's (each run at most 10000 calls, both under the one leads cap;
# leads rate rates one campaign, drupal-eol unless --campaign names another), then the
# lead list rebuilt from the findings and routes, so the console's leads keep up while only
# finding is on.
# Started by leadhound-leads-contacts.timer's 15-minute ticks, through the due-check below, and
# by leadhound-leads-contacts.path when Controls asks for a run now; install.sh enables both
# only when /etc/leadhound/env has LEADHOUND_LEADS_TIMERS=on (deploy/README.md, Leads on the
# server).
#
# Every step but the last is written ExecStart=-..., so a failed search, enrichment or
# rating never stops the build. While relevance rating is off in Leads → Settings the rating
# refuses at once and the build runs next.
[Unit]
Description=leadhound leads contact search
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=leadhound
Group=leadhound
# root:root 0600; systemd reads it before dropping to leadhound (deploy/env.example).
EnvironmentFile=/etc/leadhound/env
# The due-check, before any step: it starts the job for a Run now press at once, or when it is
# due (one interval after its last start, by hand or timed), and opens the run's row, the
# anchor of the next plan. Any doubt (not due, the job sharing its lock running, the database
# unreadable, a crash, the 1-minute timeout) exits 1-254, so systemd passes over this tick
# without a failure and the next tick tries again. --record is what lets it write, so a check
# run by hand never moves the plan. No - prefix: it would turn every "not now" into a start.
# While the site probe holds the sites' fetch lock, it waits, a press included: the search and
# the enrichment would find the lock held and skip, and the day's contacts would be lost.
ExecCondition=/usr/bin/timeout 1m /opt/leadhound/bin/leadhound timer-guard --record leads-contacts
# The probe, the contact search and the enrichment share one fetch lock in the data
# directory, so two never read the public web at once. A run that finds it held exits 75 at
# once and counts as done (SuccessExitStatus); timeout ends one that hangs. The rating and
# the build read no web page, so they run outside the lock.
ExecStart=-/usr/bin/flock --nonblock --conflict-exit-code 75 /opt/leadhound/data/.leads-fetch.lock /usr/bin/timeout --kill-after=5m 2h /opt/leadhound/bin/leadhound leads contacts --max 300
ExecStart=-/usr/bin/flock --nonblock --conflict-exit-code 75 /opt/leadhound/data/.leads-fetch.lock /usr/bin/timeout --kill-after=5m 60m /opt/leadhound/bin/leadhound leads enrich --max 300
ExecStart=-/usr/bin/timeout --kill-after=5m 180m /opt/leadhound/bin/leadhound leads rate --max 10000
ExecStart=-/usr/bin/timeout --kill-after=5m 180m /opt/leadhound/bin/leadhound leads rate --campaign cafes-loyalty --max 10000
ExecStart=/usr/bin/timeout --kill-after=5m 20m /opt/leadhound/bin/leadhound leads build
# After the last step, whatever happened: closes the run's row with systemd's own result
# ($SERVICE_RESULT, $EXIT_STATUS), also after a failure, a timeout or a kill. It does nothing
# after a tick the due-check passed over. The - keeps a failed close from marking the run
# failed; the next check closes a row left open.
ExecStopPost=-/usr/bin/timeout 1m /opt/leadhound/bin/leadhound timer-guard --record --ended leads-contacts
SuccessExitStatus=75
# Longer than the due-check's minute and the search's, the enrichment's, the two ratings' and
# the build's timeouts and kill graces together (9h46).
TimeoutStartSec=10h1min
Nice=10
IOSchedulingClass=idle
# The server is shared: a ceiling on memory, so the kernel stops leadhound and never a
# neighbour. Past MemoryMax the unit is killed; there is no MemoryHigh, because a unit
# throttled there hangs instead of failing. GOMEMLIMIT makes Go collect garbage harder
# well before the ceiling.
MemoryMax=600M
Environment=GOMEMLIMIT=450MiB
# Half the default CPU share, so a long run yields to the server's other services.
CPUWeight=50
# Hardening. The whole file system is read-only to leadhound except the data directory
# (LEADHOUND_DATA_DIR), where the fetch lock and a shadow message outbox live. It needs the
# network (public sites, mail, the Jev API, Postgres) and nothing else.
WorkingDirectory=/opt/leadhound
ReadWritePaths=/opt/leadhound/data
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Only the jobs that send, sync and check a mailbox get its private key, as a systemd
# credential; this unit sees none, so it can never read a mailbox password back.
InaccessiblePaths=-/run/credentials
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
