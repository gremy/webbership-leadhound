# /etc/leadhound/migrate.env (root:root 0600): the migration environment, nothing else.
# Copy this file there and fill in the value on the server; never commit the real one.
#
# Used only by `make deploy` (deploy/install.sh), which runs `leadhound migrate` as a
# transient unit (systemd-run -p EnvironmentFile=/etc/leadhound/migrate.env). systemd reads
# the file as root, so the owner password never reaches the Mac, an argument list or a shell
# history. No timer unit loads it.

# The owner login: leadhound_owner owns the database and runs the migrations
# (deploy/sql/roles.sql). Generate the password on the server (openssl rand -hex 32).
LEADHOUND_MIGRATE_DATABASE_URL=postgres://leadhound_owner:CHANGE_ME@localhost:5432/leadhound?sslmode=disable
