# Send now: the console's Send now. The same send as leadhound-leads-send.service, run by
# leads send --from-request, which reads the request file the console wrote,
# /opt/leadhound/data/run/leads-send-now, and nothing else from the console:
#   - a request time (RFC3339) or an empty file, as Controls' Send now writes it, is
#     leads send --now: it skips the sending window (hours and days) for this one run and
#     nothing else: the sending switch, shadow mode, the reply sync first, the warm-up and
#     domain caps, the spacing, paused and unassigned mailboxes, suppressions and every due time
#     still apply;
#   - one JSON line {"batch_id":N,"at":"<time>"}, written at a manual send's confirm, sends
#     that manual batch alone. The file is untrusted and names the batch only: the warning
#     codes the operator overrode, the batch hash they confirmed and who they are come from the
#     send_request row the console wrote, which the run claims once (no older than 15 minutes)
#     and checks again (manual, approved, the hash, codes from the closed set). Every hard stop
#     stays: suppressions, the email check, the mailbox's readiness and assignment, the hard
#     daily ceilings, one recipient domain per run, the approved text. Each message sent past
#     a warning leaves a send_override row.
#   - anything else starting with "{" is refused, and nothing is sent.
# The command line is fixed here: the console never chooses one.
# Started by leadhound-leads-send-now.path when the console asks; it has no timer. It takes
# the same database send lock as the hourly send, so the two never run at once: whichever
# starts second says "Another send is running" and does nothing.
[Unit]
Description=leadhound leads send now (outside the sending window)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=leadhound
Group=leadhound
# root:root 0600; systemd reads it before dropping to leadhound (deploy/env.example).
EnvironmentFile=/etc/leadhound/env
# The mailboxes' private key (root:root 0600, written by install.sh), handed to this job
# alone as a systemd credential: it opens the sealed passwords from
# $CREDENTIALS_DIRECTORY/mailbox-key. Only send, sync and the mailbox check get it.
LoadCredential=mailbox-key:/etc/leadhound/mailbox.key
# timeout ends a send that hangs; 25 sends spaced up to 9 minutes apart fit inside it
# (--from-request sends at most 25, as the hourly send's --max 25).
ExecStart=/usr/bin/timeout --kill-after=5m 225m /opt/leadhound/bin/leadhound leads send --from-request
# Longer than the send's timeout and its kill grace together (3h50).
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=idle
# The server is shared: a ceiling on memory, so the kernel stops leadhound and never a
# neighbour. Past MemoryMax the unit is killed; there is no MemoryHigh, because a unit
# throttled there hangs instead of failing. GOMEMLIMIT makes Go collect garbage harder
# well before the ceiling.
MemoryMax=600M
Environment=GOMEMLIMIT=450MiB
# Half the default CPU share, so a long run yields to the server's other services.
CPUWeight=50
# Hardening. The whole file system is read-only to leadhound except the data directory
# (LEADHOUND_DATA_DIR), where the fetch lock and a shadow message outbox live. It needs the
# network (public sites, mail, Postgres) and nothing else.
WorkingDirectory=/opt/leadhound
ReadWritePaths=/opt/leadhound/data
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
