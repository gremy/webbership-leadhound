# The mailbox check: logs in to each requested mailbox over SMTP (then QUIT, nothing is sent)
# and IMAP (and finds its Sent and Junk folders), checks its domain's DNS, and records the
# result the console's Mailboxes page shows. Started by leadhound-mailbox-check.path when the
# console asks; it has no timer.
[Unit]
Description=leadhound mailbox check
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=leadhound
Group=leadhound
# root:root 0600; systemd reads it before dropping to leadhound (deploy/env.example).
EnvironmentFile=/etc/leadhound/env
# The mailboxes' private key (root:root 0600, written by install.sh), handed to this job
# alone as a systemd credential: it opens the sealed passwords from
# $CREDENTIALS_DIRECTORY/mailbox-key. Only send, sync and this check get it.
LoadCredential=mailbox-key:/etc/leadhound/mailbox.key
# timeout ends a check that hangs: each mailbox's SMTP, IMAP and DNS steps have their own
# shorter limits, so 5 minutes covers every waiting request.
ExecStart=/usr/bin/timeout --kill-after=1m 5m /opt/leadhound/bin/leadhound leads mailboxes check --requested
# Longer than the check's timeout and its kill grace together (6 minutes). No Restart=: a
# check that fails shows on the Mailboxes page, and the operator asks again.
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
# The server is shared: a ceiling on memory, so the kernel stops leadhound and never a
# neighbour. Past MemoryMax the unit is killed; there is no MemoryHigh, because a unit
# throttled there hangs instead of failing. GOMEMLIMIT makes Go collect garbage harder
# well before the ceiling.
MemoryMax=600M
Environment=GOMEMLIMIT=450MiB
# Half the default CPU share, so a long run yields to the server's other services.
CPUWeight=50
# Hardening. The whole file system is read-only to leadhound except the data directory
# (LEADHOUND_DATA_DIR), where the console's request file lives. It needs the network (the
# mailboxes' servers, DNS, Postgres) and nothing else.
WorkingDirectory=/opt/leadhound
ReadWritePaths=/opt/leadhound/data
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
