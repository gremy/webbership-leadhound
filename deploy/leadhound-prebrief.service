# The morning canary: one LinkedIn search that tells the brief whether the parser still
# works. It runs once a day: a second start the same day records nothing and exits 0
# ("already ran today"). Started by leadhound-prebrief.timer.
#
# Every subcommand exits 0 once it has recorded its outcome, a stop included, and non-zero
# only for a crash or bad config. When a step is added, every step but the last is written
# ExecStart=-..., so even a crash never stops a later one.
[Unit]
Description=leadhound morning canary
# After a collect started at the same moment (a persistent catch-up after downtime).
After=network-online.target postgresql.service leadhound-collect.service
Wants=network-online.target

[Service]
Type=oneshot
User=leadhound
Group=leadhound
# root:root 0600; systemd reads it before dropping to leadhound (deploy/env.example).
EnvironmentFile=/etc/leadhound/env
# The canary holds the LinkedIn lock every LinkedIn step shares (leadhound-collect.service).
# It waits up to 45 minutes for a collect to finish; past that flock exits 75, the unit
# fails, and the brief reports the canary as missing.
ExecStart=/usr/bin/flock --wait 2700 --conflict-exit-code 75 /opt/leadhound/data/.linkedin.lock /opt/leadhound/bin/leadhound canary linkedin
# The employer apply-route check joins here once it exists, as the last step, with the
# canary line above becoming ExecStart=-/usr/bin/flock ...:
# ExecStart=/opt/leadhound/bin/leadhound routes
# The 45-minute lock wait and 30 minutes for the canary itself.
TimeoutStartSec=75min
# The server is shared: a ceiling on memory, so the kernel stops leadhound and never a
# neighbour. Past MemoryMax the unit is killed; there is no MemoryHigh, because a unit
# throttled there hangs instead of failing. GOMEMLIMIT makes Go collect garbage harder
# well before the ceiling.
MemoryMax=600M
Environment=GOMEMLIMIT=450MiB
# Hardening. The whole file system is read-only to leadhound except the data directory
# (LEADHOUND_DATA_DIR), where a brief that is not sent goes to its outbox and the score lock
# lives. It needs the network (job sources, the scoring API, mail, Postgres) and nothing else.
WorkingDirectory=/opt/leadhound
ReadWritePaths=/opt/leadhound/data
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
