# /etc/leadhound/env (root:root 0600): the environment of every leadhound unit. systemd reads
# it as root before starting the program as the leadhound user, so leadhound never needs to
# read it. Copy this file there and fill in the values on the server; never commit the real
# one. Placeholders only below. The owner role's URL lives in /etc/leadhound/migrate.env
# (deploy/migrate.env.example), never here: the timers only ever hold the app role.

# The app login (SELECT, INSERT, UPDATE only: deploy/sql/grants.sql). Postgres on the same
# server: connect over localhost. Generate the password on the server (openssl rand -hex 32)
# so it needs no escaping in the URL.
LEADHOUND_DATABASE_URL=postgres://leadhound_app:CHANGE_ME@localhost:5432/leadhound?sslmode=disable
# Pool size per process (default 4). Two units may run at once.
LEADHOUND_DB_MAX_CONNS=4

# The private data directory: leadhound.yaml and ats-boards.yaml (make deploy-data).
LEADHOUND_DATA_DIR=/opt/leadhound/data

# Live fetching on the server: 1 is every source.
LEADHOUND_LIVE=1

# Scoring model.
TYPESAFE_API_KEY=replace-me
LEADHOUND_JEV_MODEL=jev-1.13.0
# A fuse, not a budget: the most scoring calls in one day. The nightly ATS run scores
# thousands of postings.
LEADHOUND_JEV_DAILY_CALL_CAP=10000
# Runaway guard for lead relevance rating, separate from the jobs cap above. Leads settings
# may lower it, never raise it.
LEADHOUND_JEV_LEADS_DAILY_CALL_CAP=10000

# Claude (drafting, research, drafts eval): the most it may cost in one day across every
# purpose, in US dollars. Each purpose has its own lower cap inside it (drafting 3.00,
# research 1.50, drafts eval 2.00) and a cap per lead (drafting and drafts eval 0.20,
# research 0.10). Those are built in and the same for every campaign: a campaign cannot set
# its own caps yet, and this ceiling is the only one set here.
# The key itself is never set here: see deploy/README.md, "The Anthropic key".
LEADHOUND_CLAUDE_DAILY_USD_CAP=5.00

# The email check before sending (leads verify, Reoon): the most addresses checked in one day,
# counted from the day's stored checks (default 200). The key itself is never set here: see
# deploy/README.md, "The Reoon key".
LEADHOUND_REOON_DAILY_CAP=200

# Daily brief mail (brief --send).
RESEND_API_KEY=replace-me
LEADHOUND_MAIL_FROM=leadhound@mail.example
LEADHOUND_MAIL_TO=you@mail.example

# Day boundaries: the brief's day, the daily cap and the once-a-day checks.
LEADHOUND_TZ=Europe/Bucharest

# LinkedIn pacing and budgets per run.
LEADHOUND_LINKEDIN_INTERVAL=4s
LEADHOUND_LINKEDIN_SEARCH_BUDGET=60
LEADHOUND_LINKEDIN_DETAIL_BUDGET=40

# Pause between two requests to one ATS's API (the ATSs run side by side, each at this
# pace). At least 200ms; a lower value is refused.
LEADHOUND_ATS_INTERVAL=1s
# Posting-detail requests per ATS run, for an ATS whose list has no description
# (SmartRecruiters): new postings first. Over the budget, a posting is stored without its
# description and gets it on a later run.
LEADHOUND_ATS_DETAIL_BUDGET=500

# Storage fences on the shared disk: every collector stops storing (stop reason disk_budget)
# when the database passes this size in bytes (default 8589934592, 8 GiB) or free disk drops
# under this percent (1 to 99, default 15). Empty keeps the default.
LEADHOUND_DB_MAX_BYTES=
LEADHOUND_DISK_MIN_FREE_PCT=

# Console (leadhound serve). It listens on loopback only; Caddy is the way in. Without the
# email and the hash, serve refuses to start; the timers run either way.
LEADHOUND_CONSOLE_ADDR=localhost:8090
LEADHOUND_CONSOLE_EMAIL=you@mail.example
# make console-password writes it; see deploy/README.md.
LEADHOUND_CONSOLE_PASSWORD_HASH=replace-me
# The console's public https URL, for the brief's footer. Without it, or when it is not an
# https URL with a host and nothing after it, the footer names the track command instead.
LEADHOUND_CONSOLE_URL=https://console.example

# Drupal leads on the server (deploy/README.md, Leads on the server). Each line is read at
# deploy: install.sh enables the leads timers only as these say, and disables them otherwise.
# on: the finding timers (the daily site probe and contact search, unattended public reads).
LEADHOUND_LEADS_TIMERS=
# With LEADHOUND_LEADS_TIMERS=on and live outreach, the deploy also enables the batch, send and
# reply sync timers. Whether anything is sent is the Sending switch on the console's Controls
# page, never this file; every batch still waits for approval in the console. The sending
# mailboxes are added in the console (Mailboxes), never here; a run with no ready mailbox
# sends nothing and says so.
# LEADHOUND_LEADS_SEND is retired: the first deploy with the console switches read it once
# (anything but on, or no line, started sending paused), wrote /etc/leadhound/send-switch-converted
# and never reads it again, so leave it out.
# live sends over SMTP; empty is shadow, which the server never drafts in.
LEADHOUND_OUTREACH=
# The public key the console and leads mailboxes add seal each mailbox password with (base64).
# Written by install.sh on first deploy, from the private key it generates; not secret. Leave
# it empty here: install.sh replaces it whenever it does not match the key file.
LEADHOUND_MAILBOX_PUBLIC_KEY=
# The private key file, for local runs only (make mailbox-key writes one). On the server the
# key is a systemd credential handed only to the send, sync and mailbox check jobs; never set
# this there, and the console refuses to start with it set.
LEADHOUND_MAILBOX_KEY_FILE=
# The Anthropic key is a systemd credential handed only to the units that call Claude
# (deploy/README.md, The Anthropic key); it is never a line here, because this file reaches
# the console, which refuses to start when it sees ANTHROPIC_API_KEY or
# LEADHOUND_ANTHROPIC_KEY_FILE.
# The site probe's pace: requests per second across a run (default 12, at most 50) and sites
# probed at once (default 16, at most 64). Empty keeps the default.
LEADHOUND_PROBE_RATE=
LEADHOUND_PROBE_CONCURRENCY=
