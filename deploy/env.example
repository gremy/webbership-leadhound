# /etc/leadhound/env (root:root 0600): the environment of every leadhound unit. systemd reads
# it as root before starting the program as the leadhound user, so leadhound never needs to
# read it. Copy this file there and fill in the values on the server; never commit the real
# one. Placeholders only below. The owner role's URL lives in /etc/leadhound/migrate.env
# (deploy/migrate.env.example), never here: the timers only ever hold the app role.

# The app login (SELECT, INSERT, UPDATE only: deploy/sql/grants.sql). Postgres on the same
# server: connect over localhost. Generate the password on the server (openssl rand -hex 32)
# so it needs no escaping in the URL.
LEADHOUND_DATABASE_URL=postgres://leadhound_app:CHANGE_ME@localhost:5432/leadhound?sslmode=disable
# Pool size per process (default 4). Two units may run at once.
LEADHOUND_DB_MAX_CONNS=4

# The private data directory: leadhound.yaml and ats-boards.yaml (make deploy-data).
LEADHOUND_DATA_DIR=/opt/leadhound/data

# Live fetching on the server: 1 is every source.
LEADHOUND_LIVE=1

# Scoring model.
TYPESAFE_API_KEY=replace-me
LEADHOUND_JEV_MODEL=jev-1.13.0
# A fuse, not a budget: the most scoring calls in one day. The nightly ATS run scores
# thousands of postings.
LEADHOUND_JEV_DAILY_CALL_CAP=10000

# Daily brief mail (brief --send).
RESEND_API_KEY=replace-me
LEADHOUND_MAIL_FROM=leadhound@mail.example
LEADHOUND_MAIL_TO=you@mail.example

# Day boundaries: the brief's day, the daily cap and the once-a-day checks.
LEADHOUND_TZ=Europe/Bucharest

# LinkedIn pacing and budgets per run.
LEADHOUND_LINKEDIN_INTERVAL=4s
LEADHOUND_LINKEDIN_SEARCH_BUDGET=60
LEADHOUND_LINKEDIN_DETAIL_BUDGET=40

# Pause between two requests to one ATS's API (the ATSs run side by side, each at this
# pace). At least 200ms; a lower value is refused.
LEADHOUND_ATS_INTERVAL=1s
# Posting-detail requests per ATS run, for an ATS whose list has no description
# (SmartRecruiters): new postings first. Over the budget, a posting is stored without its
# description and gets it on a later run.
LEADHOUND_ATS_DETAIL_BUDGET=500
