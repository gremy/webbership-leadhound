# The daily site probe: up to 10,000 listed sites read for their Drupal major (the homepage
# and its robots file, public pages only). Started by leadhound-leads-probe.timer, which
# install.sh enables only when /etc/leadhound/env has LEADHOUND_LEADS_TIMERS=on
# (deploy/README.md, Leads on the server). Rate and concurrency come from the environment.
[Unit]
Description=leadhound leads site probe
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=leadhound
Group=leadhound
# root:root 0600; systemd reads it before dropping to leadhound (deploy/env.example).
EnvironmentFile=/etc/leadhound/env
# The probe, the contact search and the enrichment share one fetch lock in the data
# directory, so two never read the public web at once. The contacts unit (10:00) can hold it
# for its search and its enrichment, up to 190 minutes with their kill graces, so until about
# 13:20: the probe waits for it, up to 11700 seconds (195 minutes), rather than lose its day.
# A wait that runs out exits 75, which fails the unit, so a lost probe shows in systemctl.
# timeout ends a probe that hangs.
ExecStart=/usr/bin/flock --wait 11700 --conflict-exit-code 75 /opt/leadhound/data/.leads-fetch.lock /usr/bin/timeout --kill-after=5m 3h /opt/leadhound/bin/leadhound leads sites probe --max 10000
# Longer than the lock wait, the probe's timeout and its kill grace together (380 minutes).
TimeoutStartSec=390min
Nice=10
IOSchedulingClass=idle
# The server is shared: a ceiling on memory, so the kernel stops leadhound and never a
# neighbour. Past MemoryMax the unit is killed; there is no MemoryHigh, because a unit
# throttled there hangs instead of failing. GOMEMLIMIT makes Go collect garbage harder
# well before the ceiling.
MemoryMax=600M
Environment=GOMEMLIMIT=450MiB
# Half the default CPU share, so a long run yields to the server's other services.
CPUWeight=50
# Hardening. The whole file system is read-only to leadhound except the data directory
# (LEADHOUND_DATA_DIR), where the fetch lock and a shadow message outbox live. It needs the
# network (public sites, mail, Postgres) and nothing else.
WorkingDirectory=/opt/leadhound
ReadWritePaths=/opt/leadhound/data
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Only the jobs that send, sync and check a mailbox get its private key, as a systemd
# credential; this unit sees none, so it can never read a mailbox password back.
InaccessiblePaths=-/run/credentials
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
