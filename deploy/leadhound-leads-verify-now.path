# Check email now: on a Send now confirm page, a lead whose address the email check has not
# answered yet waits, and its "Check email now" makes the console write one JSON line naming
# the batch to /opt/leadhound/data/run/leads-verify-now; this watcher starts
# leadhound-leads-verify-now.service, which checks that batch's unanswered addresses. The
# console itself never holds the Reoon key and never reaches Reoon.
# It starts only that one fixed unit (no Unit=: it defaults to the same-named service), and the
# console never gains a privilege to do it. A request while the service is already starting or
# running is merged into that run by systemd.
# PathChanged= fires when the file is closed after a write, not while it merely exists, so the
# request file is never deleted, and an old one cannot fire when the watcher is armed.
# If the service hits its start limit, systemd fails this watcher too and it stops watching
# until it is reset:
#   systemctl reset-failed leadhound-leads-verify-now.path leadhound-leads-verify-now.service
#   systemctl start leadhound-leads-verify-now.path
[Unit]
Description=leadhound Check email now request

[Path]
PathChanged=/opt/leadhound/data/run/leads-verify-now

[Install]
WantedBy=paths.target
