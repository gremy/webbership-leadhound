# The Reoon credits for the console's Status page: leads verify --balance-only reads the
# credits left and stores them (or Reoon's error) in service_status, and does nothing else: no
# address is checked, no credit is spent, nothing is drafted or sent. The console holds no
# key, so this row is the only way the credits reach it. Started every 30 minutes by
# leadhound-leads-verify-balance.timer and by leadhound-leads-verify-balance.path when the
# Status page's Refresh button asks. The morning batch's check run stores the credits too, so
# the page is fresh after each batch without a step here.
#
# A Reoon outage or a key Reoon refuses is a reading, shown on the Status page, so the step
# exits 0; only a crash or a database it cannot reach fails the unit. Without LEADHOUND_LIVE
# or without the key it calls nobody, records nothing and says so.
[Unit]
Description=leadhound Reoon credits for the Status page
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=leadhound
Group=leadhound
# root:root 0600; systemd reads it before dropping to leadhound (deploy/env.example).
EnvironmentFile=/etc/leadhound/env
# The Reoon key (root:root 0600, placed by the operator by hand), handed to this job as a
# systemd credential: it reads $CREDENTIALS_DIRECTORY/reoon.key (deploy/README.md, The Reoon
# key). It gets no other key. SetCredential= with the same name is systemd's default for when
# the file cannot be read, so a server without the key still starts the unit, which says
# there is no key and records nothing.
LoadCredential=reoon.key:/etc/leadhound/reoon.key
SetCredential=reoon.key:
# timeout ends a read that hangs: one balance read is at most 30 seconds.
ExecStart=/usr/bin/timeout --kill-after=30s 2m /opt/leadhound/bin/leadhound leads verify --balance-only
# Longer than the step's timeout and its kill grace together.
TimeoutStartSec=5min
Nice=10
IOSchedulingClass=idle
# The server is shared: a ceiling on memory, so the kernel stops leadhound and never a
# neighbour. Past MemoryMax the unit is killed; there is no MemoryHigh, because a unit
# throttled there hangs instead of failing. GOMEMLIMIT makes Go collect garbage harder
# well before the ceiling.
MemoryMax=600M
Environment=GOMEMLIMIT=450MiB
# Half the default CPU share, so a run yields to the server's other services.
CPUWeight=50
# Hardening. The whole file system is read-only to leadhound except the data directory
# (LEADHOUND_DATA_DIR). It needs the network (the Reoon API, Postgres) and nothing else.
WorkingDirectory=/opt/leadhound
ReadWritePaths=/opt/leadhound/data
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No InaccessiblePaths=-/run/credentials here: it would hide the unit's own Reoon key.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
