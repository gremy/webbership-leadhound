# The morning batch: rebuild the lead list, then draft the next batch for the operator to
# read and approve in the console. A batch still waiting makes batch new a no-op. Nothing
# here sends. Started by leadhound-leads-batch.timer, which install.sh enables only when
# sending is switched on (deploy/README.md, Leads on the server).
#
# Every subcommand exits 0 once it has recorded its outcome and non-zero only for a crash or
# bad config; saved settings that no longer fit leads.yaml count as bad config, so batch new
# fails the unit rather than draft without them. Every step but the last is written
# ExecStart=-..., so even a crash never stops a later one.
[Unit]
Description=leadhound leads build and next batch
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=leadhound
Group=leadhound
# root:root 0600; systemd reads it before dropping to leadhound (deploy/env.example).
EnvironmentFile=/etc/leadhound/env
# The Anthropic key (root:root 0600, placed by the operator by hand), handed to this job as a
# systemd credential, because drafting with Claude runs at batch time: it reads
# $CREDENTIALS_DIRECTORY/anthropic-key. Only the units that call Claude get it, never the
# console (deploy/README.md, The Anthropic key). A missing file fails the unit at start.
LoadCredential=anthropic-key:/etc/leadhound/anthropic.key
# timeout ends a step that hangs.
ExecStart=-/usr/bin/timeout --kill-after=5m 20m /opt/leadhound/bin/leadhound leads build
ExecStart=/usr/bin/timeout --kill-after=5m 20m /opt/leadhound/bin/leadhound leads batch new
# Longer than both steps' timeouts and kill graces together (50 minutes).
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle
# The server is shared: a ceiling on memory, so the kernel stops leadhound and never a
# neighbour. Past MemoryMax the unit is killed; there is no MemoryHigh, because a unit
# throttled there hangs instead of failing. GOMEMLIMIT makes Go collect garbage harder
# well before the ceiling.
MemoryMax=600M
Environment=GOMEMLIMIT=450MiB
# Half the default CPU share, so a long run yields to the server's other services.
CPUWeight=50
# Hardening. The whole file system is read-only to leadhound except the data directory
# (LEADHOUND_DATA_DIR), where the fetch lock and a shadow message outbox live. It needs the
# network (public sites, mail, Postgres) and nothing else.
WorkingDirectory=/opt/leadhound
ReadWritePaths=/opt/leadhound/data
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No InaccessiblePaths=-/run/credentials here: it would hide the unit's own Anthropic key.
# The mailbox key is never given to this unit, so it still cannot read a mailbox password.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
