# The nightly ATS run: every board in the registry and ats-boards.yaml, then a score of what
# it stored. Started by leadhound-ats.timer.
#
# Every subcommand exits 0 once it has recorded its outcome, a stop (throttled, budget,
# parser_broke, spend_cap ...) included, and non-zero only for a crash or bad config.
# Every step but the last is written ExecStart=-..., so even a crash never stops a later one.
[Unit]
Description=leadhound ATS collect and score
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=leadhound
Group=leadhound
# root:root 0600; systemd reads it before dropping to leadhound (deploy/env.example).
EnvironmentFile=/etc/leadhound/env
# timeout ends a collect that hangs, so the score after it still runs.
ExecStart=-/usr/bin/timeout --kill-after=5m 5h /opt/leadhound/bin/leadhound collect ats
# Two units may score at once (a long night collect running into the morning one), so
# score waits for the other on a lock in the data directory instead of running beside it.
ExecStart=/usr/bin/flock --wait 5400 /opt/leadhound/data/.score.lock /opt/leadhound/bin/leadhound score
# The full registry takes hours to collect. Longer than the collect's 5h timeout and the
# score's 90-minute lock wait together, so systemd never cuts the score short.
TimeoutStartSec=7h
Nice=10
IOSchedulingClass=idle
# The server is shared: a ceiling on memory, so the kernel stops leadhound and never a
# neighbour. A collect has peaked near 530 MB; past MemoryHigh the unit is slowed and reclaimed,
# past MemoryMax it is killed.
MemoryHigh=900M
MemoryMax=1200M
# Half the default CPU share, so a long collect yields to the server's other services.
CPUWeight=50
# Hardening. The whole file system is read-only to leadhound except the data directory
# (LEADHOUND_DATA_DIR), where a brief that is not sent goes to its outbox and the score lock
# lives. It needs the network (job sources, the scoring API, mail, Postgres) and nothing else.
WorkingDirectory=/opt/leadhound
ReadWritePaths=/opt/leadhound/data
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
